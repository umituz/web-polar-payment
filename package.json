{
  "name": "@umituz/web-polar-payment",
  "version": "2.2.0",
  "description": "Universal Polar.sh subscription billing — adapter-based, framework-agnostic core with React bindings",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./products": {
      "types": "./dist/products.d.ts",
      "import": "./dist/products.mjs",
      "require": "./dist/products.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./portal": {
      "types": "./dist/portal.d.ts",
      "import": "./dist/portal.mjs",
      "require": "./dist/portal.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "require": "./dist/http.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.mjs",
      "require": "./dist/memory.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/products.ts src/react.tsx src/portal.ts src/server.ts src/http.ts src/memory.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/core.ts src/products.ts src/react.tsx src/portal.ts src/server.ts src/http.ts src/memory.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "polar",
    "subscription",
    "billing",
    "react",
    "adapter",
    "facade",
    "repository"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-polar-payment.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-polar-payment/issues"
  },
  "homepage": "https://github.com/umituz/web-polar-payment#readme",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.577.0 || ^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.0"
  }
}
